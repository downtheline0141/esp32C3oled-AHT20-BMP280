#include <Arduino.h>
#include <Wire.h>
#include <U8g2lib.h>
#include <Adafruit_AHTX0.h>
#include <Adafruit_BMP280.h>

#define OLED_SDA 5
#define OLED_SCL 6
#define SENS_SDA 7
#define SENS_SCL 8
#define OX 28
#define OY 24

U8G2_SSD1306_128X64_NONAME_F_SW_I2C u8g2(U8G2_R0, OLED_SCL, OLED_SDA, U8X8_PIN_NONE);
Adafruit_AHTX0 aht;
Adafruit_BMP280 bmp;

void setup() {
  u8g2.begin();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.clearBuffer();
  u8g2.drawFrame(OX, OY, 72, 40);
  u8g2.sendBuffer();

  Wire.begin(SENS_SDA, SENS_SCL);
  bool ahtOk = aht.begin();
  bool bmpOk = bmp.begin(0x76) || bmp.begin(0x77);

  if (!ahtOk || !bmpOk) {
    u8g2.clearBuffer();
    u8g2.drawStr(OX + 2, OY + 12, ahtOk ? "AHT20 OK" : "AHT20 NG");
    u8g2.drawStr(OX + 2, OY + 24, bmpOk ? "BMP280 OK" : "BMP280 NG");
    u8g2.sendBuffer();
    while (true) delay(1000);
  }
}

void loop() {
  sensors_event_t hum, temp;
  aht.getEvent(&hum, &temp);
  float press = bmp.readPressure() / 100.0f;

  char buf[20];
  u8g2.clearBuffer();
  snprintf(buf, sizeof(buf), "T:%.1f C", temp.temperature);
  u8g2.drawStr(OX + 2, OY + 10, buf);
  snprintf(buf, sizeof(buf), "H:%.1f %%", hum.relative_humidity);
  u8g2.drawStr(OX + 2, OY + 22, buf);
  snprintf(buf, sizeof(buf), "P:%.0f hPa", press);
  u8g2.drawStr(OX + 2, OY + 34, buf);
  u8g2.sendBuffer();

  delay(2000);
}